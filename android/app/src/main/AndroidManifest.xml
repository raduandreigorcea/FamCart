<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Scanning a barcode onto the list. There is no camera plugin: the web
         layer calls getUserMedia, and Capacitor's WebView grants it only if the
         permission is declared here and the user allows it at the prompt.
         required="false" so a device without a camera can still install the app;
         the add form asks what the device can do before offering the button. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth return leg: Clerk redirects the system browser to
                 famcart://sso-callback, which re-opens this activity
                 (singleTask, so the running instance receives it as an
                 appUrlOpen event instead of a relaunch). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="famcart" android:host="sso-callback" />
            </intent-filter>

        </activity>

        <!-- Tints OneSignal notifications (icon + app name row) FamCart green;
             the small icon itself is ic_stat_onesignal_default in drawable-*. -->
        <meta-data
            android:name="com.onesignal.NotificationAccentColor.DEFAULT"
            android:value="FF4D8C65" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Updating the app from inside the app. FamCart is downloaded as an APK
         rather than installed from a store, so nothing updates it on the user's
         behalf; AppInstallerPlugin fetches the new release and hands it to the
         system installer, which is refused outright without this. Declaring it
         is not consent: since Android 8 the user still has to allow "install
         unknown apps" for FamCart specifically, and the plugin checks for that
         before it downloads anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
