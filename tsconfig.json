{
  // Typechecking runs through vue-tsc, so .vue files are in scope alongside the
  // .ts under lib/ and router/. Every SFC declares lang="ts", so this is the
  // whole of src — script blocks and templates both.
  //
  // It was not always: the SFCs were plain JS, and this config carried allowJs
  // plus a second, looser tsconfig.sfc.json to triage them a file at a time.
  // Both are gone now that the migration is done, along with the checkJs escape
  // hatch — there is no JavaScript left in src for it to apply to.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // The edge function's shared half is checked here; the function itself is not,
  // and the line between them is what makes that possible.
  //
  // supabase/functions/_shared holds no Deno API, no Node built-in and no npm
  // import, so it type-checks against the same lib as the app. push-on-item-insert
  // /index.ts is the opposite: `Deno.serve`, `Deno.env` and a `npm:` specifier
  // are meaningless to vue-tsc and would each be an error. Including the whole
  // directory would therefore mean either failing the build or loosening the
  // config until it checked nothing, which is how this ended up unchecked in the
  // first place.
  //
  // So the decisions are checked and the wiring is not, and the wiring is kept
  // small enough to read for that reason.
  "include": ["src/**/*.ts", "src/**/*.vue", "supabase/functions/_shared/**/*.ts"]
}
